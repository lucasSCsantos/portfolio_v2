{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e-sea/types/**/*.ts",
    ".next-e2e-waves/types/**/*.ts",
    ".scratch/build-hero/types/**/*.ts",
    ".scratch/build-jobs/types/**/*.ts",
    ".scratch/build-servicos/types/**/*.ts",
    ".scratch/build-habilidades/types/**/*.ts",
    ".scratch/build-contato/types/**/*.ts",
    ".scratch/build-hero-2/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
